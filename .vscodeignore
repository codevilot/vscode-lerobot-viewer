out/**
out-webview/**
src/**
webview/**
node_modules/**
# SSH stack must ship at runtime (esbuild externalizes it because of native
# bindings); list the entire transitive closure here.
!node_modules/ssh2-sftp-client/**
!node_modules/ssh2/**
!node_modules/cpu-features/**
!node_modules/asn1/**
!node_modules/bcrypt-pbkdf/**
!node_modules/safer-buffer/**
!node_modules/tweetnacl/**
!node_modules/concat-stream/**
!node_modules/buffer-from/**
!node_modules/inherits/**
!node_modules/readable-stream/**
!node_modules/typedarray/**
# parquetjs + transitive closure (v3 → v2.1 conversion).
!node_modules/parquetjs/**
!node_modules/brotli/**
!node_modules/base64-js/**
!node_modules/bson/**
!node_modules/int53/**
!node_modules/object-stream/**
!node_modules/snappyjs/**
!node_modules/thrift/**
!node_modules/varint/**
!node_modules/node-int64/**
!node_modules/q/**
!node_modules/ws/**
